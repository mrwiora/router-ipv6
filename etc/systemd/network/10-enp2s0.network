[Match]
Name=enp2s0

[Network]
# WAN1 with prefix delegation
DHCP=ipv6
Address=172.17.254.102/24
Gateway=172.17.254.1
IPv6AcceptRA=yes
IPv6Forwarding=yes

[DHCPv6]
# Request prefix delegation (/63)
PrefixDelegationHint=::/59
UseAddress=yes
RouteMetric=300

[DHCPv6PrefixDelegation]
# Delegate subnet 0 to enp1s0
SubnetId=0
Announce=no
Assign=no

[DHCPv6PrefixDelegation]
# Delegate subnet 1 to enp9s0
SubnetId=1
Announce=no
Assign=no

[DHCPv6PrefixDelegation]
# Delegate subnet 2 to enp10s0
SubnetId=2
Announce=no
Assign=no

[DHCPv6PrefixDelegation]
# Delegate subnet 3 to enp11s0
SubnetId=3
Announce=no
Assign=no

[IPv6AcceptRA]
DHCPv6Client=always
UseAutonomousPrefix=no
UseRoutes=yes

[Route]
# IPv6: Add default route to table 100 (fallback)
Gateway=_dhcp6
Table=100
Metric=300

[Route]
# IPv4: Add default route to table 100 (fallback via enp7s0)
Gateway=172.17.254.1
Table=100
Metric=300
