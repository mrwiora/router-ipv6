[Match]
Name=enp8s0

[Network]
# WAN2 - Primary route with NAT66
DHCP=yes
IPv6AcceptRA=yes
IPv6Forwarding=yes

[IPv6AcceptRA]
# Use SLAAC for address assignment
UseAutonomousPrefix=yes
DHCPv6Client=no
RouteTable=200
RouteMetric=200

[Route]
# Add default route to table 200 (primary)
Gateway=_ipv6ra
Table=200
Metric=200

