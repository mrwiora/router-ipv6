[Match]
Name=enp1s0

[Network]
# LAN interface - advertises ONLY delegated prefix from WAN1
# No ULA - clients get one address from delegated prefix
Address=172.17.0.254/24
IPv6AcceptRA=no
IPv6SendRA=yes
IPv6Forwarding=yes
DHCPPrefixDelegation=yes

[IPv6SendRA]
# Enable router advertisements on LAN
Managed=no
OtherInformation=no
RouterLifetimeSec=1800

[DHCPPrefixDelegation]
# Receive and advertise delegated prefix from WAN1
SubnetId=0
Announce=yes
Assign=yes
Token=::1

[RoutingPolicyRule]
# IPv4: Traffic TO router's LAN IP must use main table (highest priority)
To=172.17.0.254
Table=main
Priority=10

[RoutingPolicyRule]
# IPv4: Traffic TO LAN subnet must use main table (prevent policy routing responses)
To=172.17.0.0/24
Table=main
Priority=20

[RoutingPolicyRule]
# IPv6: Traffic TO router's LAN IPv6 address must use main table (highest priority)
To=2a00:1f:c0:9bfa::1/128
Table=main
Priority=10

[RoutingPolicyRule]
# IPv6: Traffic TO LAN subnet must use main table (prevent policy routing responses)
To=2a00:1f:c0:9bfa::/64
Table=main
Priority=20

[RoutingPolicyRule]
# IPv4: Keep local LAN traffic on LAN (source and destination both in LAN)
From=172.17.0.0/24
To=172.17.0.0/24
Table=main
Priority=50

[RoutingPolicyRule]
# IPv6: Keep local LAN traffic on LAN (source and destination both in LAN)
From=2a00:1f:c0:9bfa::/64
To=2a00:1f:c0:9bfa::/64
Table=main
Priority=50

[RoutingPolicyRule]
# IPv6 Primary: Route delegated prefix traffic via WAN2 (NAT66) - higher priority
From=2a00:1f:c0:9bfa::/64
Table=200
Priority=100

[RoutingPolicyRule]
# IPv6 Fallback: Use WAN1 (native) if WAN2 is down - lower priority
From=2a00:1f:c0:9bfa::/64
Table=100
Priority=200

[RoutingPolicyRule]
# IPv4 Primary: Route LAN traffic via WAN2 (enp8s0) - higher priority
From=172.17.0.0/24
Table=200
Priority=100

[RoutingPolicyRule]
# IPv4 Fallback: Use WAN1 (enp7s0) if WAN2 is down - lower priority
From=172.17.0.0/24
Table=100
Priority=200
